<Project>
  <PropertyGroup>
    <!--
      net10.0 = PRIMARY target (LTS until Nov 2028, C# 14, best perf)
      net9.0  = STS, supported until Nov 2026
      net8.0  = LTS, minimum bar for broad ecosystem compat
    -->
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Explicitly pin C# 14 -->
    <LangVersion>14</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- AOT / trimming annotations — only relevant for Core library -->
    <IsAotCompatible Condition="'$(TargetFramework)' == 'net10.0' AND '$(MSBuildProjectName)' == 'MailVolt.Core'">true</IsAotCompatible>
    <EnableTrimAnalyzer Condition="'$(TargetFramework)' == 'net10.0' AND '$(MSBuildProjectName)' == 'MailVolt.Core'">true</EnableTrimAnalyzer>
    <SuppressTrimAnalysisWarnings Condition="'$(TargetFramework)' != 'net10.0' OR '$(MSBuildProjectName)' != 'MailVolt.Core'">true</SuppressTrimAnalysisWarnings>
    <Authors>Denis Cuciuc</Authors>
    <Company>Denis Cuciuc</Company>
    <Copyright>Copyright © 2026 Denis Cuciuc</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/deniscuciuc/mailvolt</PackageProjectUrl>
    <RepositoryUrl>https://github.com/deniscuciuc/mailvolt</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>email;mail;smtp;sendgrid;mailgun;resend;postmark;dotnet;csharp;net10</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <Deterministic>true</Deterministic>
    <!-- Without this, SourceLink bakes local absolute paths into the PDBs and the
         published .snupkg files do not work for consumers. -->
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <!--
      Vulnerability warnings are NOT suppressed: a library published to NuGet must
      surface its own advisories. NU1902/NU1903 stay as errors via
      TreatWarningsAsErrors, so a vulnerable dependency fails the build.
    -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <!-- NU1506: duplicate PackageVersion. IL2026/IL3050 are scoped per-project instead. -->
    <NoWarn>$(NoWarn);NU1506</NoWarn>
    <!-- Non-packable projects (examples, tests) should not warn during pack -->
    <WarnOnPackingNonPackableProject>false</WarnOnPackingNonPackableProject>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="\" />
    <!-- Each package ships its own README.md; the root one is only a fallback. -->
    <None Include="README.md" Condition="Exists('$(MSBuildProjectDirectory)/README.md')" Pack="true" PackagePath="\" />
    <None Include="$(MSBuildThisFileDirectory)README.md" Condition="!Exists('$(MSBuildProjectDirectory)/README.md')" Pack="true" PackagePath="\" />
  </ItemGroup>
  <PropertyGroup>
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <PackageReference Include="MinVer" PrivateAssets="All" />
  </ItemGroup>
  <!-- Only the shipped libraries expose internals to the test assemblies; examples
       and test projects have no reason to carry these attributes. -->
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <InternalsVisibleTo Include="MailVolt.Core.Tests" />
    <InternalsVisibleTo Include="MailVolt.Transport.Tests" />
    <InternalsVisibleTo Include="MailVolt.Templates.Tests" />
    <InternalsVisibleTo Include="MailVolt.Testing.Tests" />
    <InternalsVisibleTo Include="MailVolt.AutoConfigure.Tests" />
    <InternalsVisibleTo Include="MailVolt.Integration.Tests" />
  </ItemGroup>
</Project>
